# Base URL of the application (frontend)
# The fixture will use this to proxy API calls: BASE_URL/api/auth/test/mock-login
BASE_URL=http://localhost:5173

# Run tests in headless mode (True/False)
HEADLESS=True

# Implicit wait timeout in seconds
IMPLICIT_WAIT=10

# Explicit wait timeout in seconds
EXPLICIT_WAIT=20

# Whether to use secure JWT cookie (True/False)
IS_JWT_SECURE=False

# Backend authentication endpoints (for reference/manual use)
# The authenticated_driver fixture now uses frontend proxy instead of direct backend URLs
# TEST_LOGIN_URL=http://localhost:8080/api/auth/test/mock-login
# TEST_DELETE_URL=http://localhost:8080/api/users/me
